# Local dev reverse proxy — mirrors the Vercel Multi-Zones URL shape so
# Clerk's cookie covers every zone (one origin in the browser's view).
#
# Run with `pnpm dev:proxy` (requires Caddy: `brew install caddy`).
# Apps must be running on their own ports already (`pnpm dev` in another
# shell).
#
# Browser hits localhost:5173 → Caddy → underlying app on its native port:
#   /budget/*         → localhost:3000 (Caddy strips /budget before forwarding)
#   /api/<name>/*     → localhost:3xxx (added per app-* project as we go)
#   /*  (anything else) → localhost:3001 (Home)
#
# Limitation: Caddy strips /budget on the way in, so Budget's dev server
# sees requests at /. When Budget adds internal routes (e.g.
# /transactions), the browser URL becomes localhost:5173/transactions —
# Caddy doesn't recognise the prefix and routes to Home (404).
# Fix when that happens: either add explicit handle blocks per internal
# route, or revert Budget to base: '/budget/' in dev and add a Vite
# middleware to fix the @react-refresh 404. One-route-per-app is fine
# for now.
{
	auto_https off
	admin off
}

:5173 {
	handle_path /budget/* {
		reverse_proxy localhost:3000
	}

	handle {
		reverse_proxy localhost:3001
	}
}
