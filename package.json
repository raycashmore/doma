{
  "name": "doma",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "bot": "pnpm --filter api-bot dev",
    "bot:test": "pnpm --filter api-bot test",
    "convex": "pnpm --filter @repo/convex dev",
    "seed": "pnpm --filter @repo/convex seed",
    "seed:clear": "pnpm --filter @repo/convex seed:clear",
    "seed:url": "pnpm --filter @repo/convex seed",
    "seed:url:clear": "pnpm --filter @repo/convex seed:clear"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.3",
    "typescript": "5.9.2",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
