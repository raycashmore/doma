{
  "name": "doma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,vue,svelte,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,vue,svelte,md,yaml,yml}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "ci:checks": "node --test scripts/ci-checks.test.mjs && scripts/ci-checks.sh",
    "ci:local": "scripts/ci-local.sh",
    "evals": "node --experimental-strip-types evals/demo.ts",
    "evals:test": "node --experimental-strip-types --test evals/**/*.test.ts",
    "evals:weekly-meals": "tsx evals/weekly-meals/run.ts",
    "bot": "pnpm --filter api-bot dev",
    "agent": "pnpm --filter api-agent dev",
    "bot:test": "pnpm --filter api-bot test",
    "convex": "pnpm --filter @repo/convex dev",
    "seed": "pnpm --filter @repo/convex seed",
    "seed:clear": "pnpm --filter @repo/convex seed:clear",
    "seed:url": "pnpm --filter @repo/convex seed",
    "seed:url:clear": "pnpm --filter @repo/convex seed:clear"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
