{
  "name": "meals",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3005",
    "dev:no-auth": "dotenv -e ../../.env.local -- sh -c 'VITE_CLERK_PUBLISHABLE_KEY= vite dev --port 3005'",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@repo/convex": "workspace:*",
    "@repo/shell": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.61",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^0.561.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1"
