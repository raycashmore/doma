{
  "name": "lists",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3004",
    "dev:no-auth": "dotenv -e ../../.env.local -- sh -c 'VITE_CLERK_PUBLISHABLE_KEY= vite dev --port 3004'",
    "build": "vite build",
    "preview": "vite preview --port 3004",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.39.0",
    "@clerk/shared": "^4.40.0",
    "@repo/app-registry": "workspace:*",
    "@repo/convex": "workspace:*",
    "@repo/pwa": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "convex": "^1.46.0",
    "convex-svelte": "^0.14.0",
    "dotenv-cli": "^11.0.0",
    "svelte": "^5.57.2",
    "svelte-dnd-action": "^0.9.80",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
