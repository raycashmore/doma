{
  "name": "lists",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3004",
    "dev:no-auth": "dotenv -e ../../.env.local -- sh -c 'VITE_CLERK_PUBLISHABLE_KEY= vite dev --port 3004'",
    "build": "vite build",
    "preview": "vite preview --port 3004",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --fix .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.16.1",
    "@clerk/shared": "^4.17.1",
    "@repo/app-registry": "workspace:*",
    "@repo/convex": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.0.6",
    "convex": "^1.27.3",
    "convex-svelte": "^0.13.0",
    "dotenv-cli": "^11.0.0",
    "svelte": "^5.56.3",
    "svelte-dnd-action": "^0.9.70",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.3.6",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^0.21.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
