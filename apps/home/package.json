{
  "name": "home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3000",
    "dev:no-auth": "dotenv -e ../../.env.local -- sh -c 'VITE_CLERK_PUBLISHABLE_KEY= vite dev --port 3000'",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "vue-tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --fix",
    "test": "vitest run --config vitest.config.ts",
    "start": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@clerk/vue": "^2.4.17",
    "@lucide/vue": "^1.25.0",
    "@repo/app-registry": "workspace:*",
    "@repo/convex": "workspace:*",
    "@repo/pwa": "workspace:*",
    "@repo/tokens": "workspace:*",
    "convex": "^1.42.3",
    "convex-vue": "^0.1.5",
    "dotenv-cli": "^11.0.0",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
