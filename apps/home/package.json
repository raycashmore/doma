{
  "name": "home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3000",
    "dev:no-auth": "dotenv -e ../../.env.local -- sh -c 'VITE_CLERK_PUBLISHABLE_KEY= vite dev --port 3000'",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "vue-tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --fix",
    "test": "vitest run --config vitest.config.ts",
    "start": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@clerk/vue": "^2.5.12",
    "@lucide/vue": "^1.55.0",
    "@repo/app-registry": "workspace:*",
    "@repo/convex": "workspace:*",
    "@repo/pwa": "workspace:*",
    "@repo/tokens": "workspace:*",
    "convex": "^1.46.0",
    "convex-vue": "^0.1.5",
    "dotenv-cli": "^11.0.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
