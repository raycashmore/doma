{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": ".output/public",
  "rewrites": [
    {
      "source": "/budget",
      "destination": "https://doma-budget.vercel.app/budget"
    },
    {
      "source": "/budget/:path*",
      "destination": "https://doma-budget.vercel.app/budget/:path*"
    }
  ]
}
