{
  "name": "@repo/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./convex/_generated/api.js",
  "types": "./convex/_generated/api.d.ts",
  "exports": {
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./lists/model": "./convex/lists/model.ts",
    "./lists/transitions": "./convex/lists/transitions.ts",
    "./meals/model": "./convex/meals/model.ts",
    "./schema": "./convex/schema.ts",
    "./auth": "./convex/auth.config.ts",
    "./helpers": "./convex/helpers.ts",
    "./budgetSummary": "./convex/budgetSummary.ts",
    "./monthDetail": "./convex/monthDetail.ts"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- convex dev",
    "deploy": "dotenv -e ../../.env.local -- convex deploy",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:clear": "tsx scripts/clearAll.ts"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.9.1",
    "nanoid": "^5.1.16",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
